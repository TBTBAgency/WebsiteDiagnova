generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model User {
  id               String          @id @default(cuid())
  name             String          @db.VarChar(100)
  email            String          @unique @db.VarChar(255)
  passwordHash     String?         @map("password_hash") @db.VarChar(255)
  institution      String?         @db.VarChar(150)
  jobTitle         String?         @map("job_title") @db.VarChar(100)
  phone            String?         @db.VarChar(30)
  roleId           String?         @map("role_id")
  role             Role?           @relation(fields: [roleId], references: [id])
  status           Int             @default(1)
  demoDurationDays Int?            @map("demo_duration_days")
  demoActivatedAt  DateTime?       @map("demo_activated_at")
  demoExpiresAt    DateTime?       @map("demo_expires_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  leads            Lead[]
  magicLinks       DemoMagicLink[]

  @@map("users")
}

model Lead {
  id                 String             @id @default(cuid())
  userId             String?            @map("user_id")
  user               User?              @relation(fields: [userId], references: [id])
  name               String             @db.VarChar(100)
  institution        String             @db.VarChar(150)
  jobTitle           String             @db.VarChar(100)
  email              String             @db.VarChar(255)
  phone              String             @db.VarChar(30)
  institutionType    InstitutionType    @default(HOSPITAL) @map("institution_type")
  notes              String?
  status             Int                @default(1)
  approvalStatus     LeadApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt         DateTime?          @map("approved_at")
  approvedBy         String?            @map("approved_by") @db.VarChar(100)
  rejectionReason    String?            @map("rejection_reason")
  requestedDemoDate  DateTime?          @map("requested_demo_date")
  confirmedDemoDate  DateTime?          @map("confirmed_demo_date")
  demoDate           DateTime?          @map("demo_date")
  demoDurationDays   Int                @default(3) @map("demo_duration_days")
  voucherCode        String?            @map("voucher_code") @db.VarChar(50)
  voucherExpiry      DateTime?          @map("voucher_expiry")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  magicLinks         DemoMagicLink[]

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([approvalStatus])
  @@index([createdAt])
  @@map("leads")
}

model DemoMagicLink {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  email     String    @db.VarChar(255)
  leadId    String    @map("lead_id")
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address") @db.VarChar(50)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tokenHash])
  @@index([email])
  @@index([leadId])
  @@map("demo_magic_links")
}


model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  recordId  String?  @map("record_id") @db.VarChar(100)
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Patient {
  id         String     @id @default(cuid())
  mrn        String     @unique @db.VarChar(50)
  nationalId String?    @unique @map("national_id") @db.VarChar(30)
  name       String     @db.VarChar(120)
  birthDate  DateTime   @map("birth_date")
  sex        gender
  phone      String?    @db.VarChar(30)
  address    String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  orders     LabOrder[]

  @@index([mrn])
  @@index([name])
  @@map("patients")
}

model Physician {
  id             String     @id @default(cuid())
  externalCode   String     @unique @map("external_code") @db.VarChar(50)
  name           String     @db.VarChar(120)
  specialization String     @db.VarChar(100)
  department     String     @db.VarChar(100)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  orders         LabOrder[]

  @@map("physicians")
}

model TestCatalog {
  id           String         @id @default(cuid())
  code         String         @unique @db.VarChar(50)
  name         String         @db.VarChar(150)
  category     String         @db.VarChar(100)
  specimenType SpecimenType   @default(WHOLE_BLOOD) @map("specimen_type")
  tubeColor    TubeColor      @default(LAVENDER_EDTA) @map("tube_color")
  unit         String?        @db.VarChar(30)
  tatMinutes   Int            @default(60) @map("tat_minutes")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  orderItems   LabOrderItem[]

  @@index([category])
  @@map("test_catalogs")
}

model LabOrder {
  id             String         @id @default(cuid())
  orderNumber    String         @unique @map("order_number") @db.VarChar(50)
  patientId      String         @map("patient_id")
  physicianId    String?        @map("physician_id")
  sourceLocation String         @map("source_location") @db.VarChar(100)
  priority       OrderPriority  @default(ROUTINE)
  clinicalNotes  String?        @map("clinical_notes")
  status         OrderStatus    @default(ORDERED)
  orderedAt      DateTime       @default(now()) @map("ordered_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  items          LabOrderItem[]
  patient        Patient        @relation(fields: [patientId], references: [id])
  physician      Physician?     @relation(fields: [physicianId], references: [id])
  specimens      Specimen[]

  @@index([orderNumber])
  @@index([patientId])
  @@index([status])
  @@index([priority])
  @@index([orderedAt])
  @@map("lab_orders")
}

model LabOrderItem {
  id            String      @id @default(cuid())
  orderId       String      @map("order_id")
  testCatalogId String      @map("test_catalog_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  order         LabOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  testCatalog   TestCatalog @relation(fields: [testCatalogId], references: [id])

  @@index([orderId])
  @@index([testCatalogId])
  @@map("lab_order_items")
}

model Specimen {
  id              String         @id @default(cuid())
  barcodeNumber   String         @unique @map("barcode_number") @db.VarChar(50)
  orderId         String         @map("order_id")
  specimenType    SpecimenType   @map("specimen_type")
  tubeColor       TubeColor      @map("tube_color")
  volume          String?        @default("3.0 mL") @db.VarChar(30)
  collectedAt     DateTime       @default(now()) @map("collected_at")
  receivedAt      DateTime?      @map("received_at")
  status          SpecimenStatus @default(COLLECTED)
  rejectionReason String?        @map("rejection_reason")
  rejectedBy      String?        @map("rejected_by") @db.VarChar(100)
  rejectedAt      DateTime?      @map("rejected_at")
  receivedBy      String?        @map("received_by") @db.VarChar(100)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  order           LabOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([barcodeNumber])
  @@index([orderId])
  @@index([status])
  @@map("specimens")
}

enum LeadApprovalStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("lead_approval_status")
}

enum LeadStatus {
  NEW       @map("new")
  CONTACTED @map("contacted")
  SCHEDULED @map("scheduled")
  COMPLETED @map("completed")

  @@map("lead_status")
}

enum InstitutionType {
  HOSPITAL            @map("hospital")
  CLINICAL_LAB        @map("clinical-lab")
  PATHOLOGY_CENTER    @map("pathology-center")
  MICROBIOLOGY_CENTER @map("microbiology-center")
  BLOOD_BANK          @map("blood-bank")
  OTHER               @map("other")

  @@map("institution_type")
}

enum UserRole {
  SUPER_ADMIN @map("super_admin")
  SALES_ADMIN @map("sales_admin")
  LAB_STAFF   @map("lab_staff")
  PATHOLOGIST @map("pathologist")
  DEMO_USER   @map("demo_user")

  @@map("user_role")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("user_status")
}

enum OrderPriority {
  ROUTINE @map("routine")
  CITO    @map("cito")
  URGENT  @map("urgent")

  @@map("order_priority")
}

enum OrderStatus {
  ORDERED             @map("ordered")
  SPECIMEN_RECEIVED   @map("specimen_received")
  PROCESSING          @map("processing")
  PARTIALLY_VALIDATED @map("partially_validated")
  COMPLETED           @map("completed")
  CANCELLED           @map("cancelled")

  @@map("order_status")
}

enum SpecimenStatus {
  COLLECTED       @map("collected")
  RECEIVED_IN_LAB @map("received_in_lab")
  PROCESSING      @map("processing")
  ARCHIVED        @map("archived")
  REJECTED        @map("rejected")

  @@map("specimen_status")
}

enum SpecimenType {
  WHOLE_BLOOD @map("whole_blood")
  SERUM       @map("serum")
  PLASMA      @map("plasma")
  URINE       @map("urine")
  CSF         @map("csf")
  STOOL       @map("stool")
  SWAB        @map("swab")
  OTHER       @map("other")

  @@map("specimen_type")
}

enum TubeColor {
  LAVENDER_EDTA      @map("lavender_edta")
  RED_PLAIN          @map("red_plain")
  YELLOW_SST         @map("yellow_sst")
  LIGHT_BLUE_CITRATE @map("light_blue_citrate")
  GRAY_FLUORIDE      @map("gray_fluoride")
  GREEN_HEPARIN      @map("green_heparin")
  URINE_CONTAINER    @map("urine_container")
  other

  @@map("tube_color")
}

enum gender {
  male
  female
}

// ==========================================
// CONTENT MANAGEMENT SYSTEM (CMS) MODELS
// ==========================================

model CmsSection {
  id              String               @id @default(cuid())
  sectionKey      String               @unique @map("section_key") @db.VarChar(50)
  badgeId         String?              @map("badge_id")
  badgeEn         String?              @map("badge_en")
  titleId         String?              @map("title_id")
  titleEn         String?              @map("title_en")
  subtitleId      String?              @map("subtitle_id")
  subtitleEn      String?              @map("subtitle_en")
  extraContent    Json?                @map("extra_content")
  isPublished     Boolean              @default(true) @map("is_published")
  updatedBy       String?              @map("updated_by") @db.VarChar(100)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  heroSlides      CmsHeroSlide[]
  comparisonItems CmsComparisonItem[]
  testimonials    CmsTestimonial[]
  partners        CmsPartner[]

  @@map("cms_sections")
}

model CmsHeroSlide {
  id                 String      @id @default(cuid())
  sectionId          String?     @map("section_id")
  section            CmsSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  titleId            String      @map("title_id")
  titleEn            String      @map("title_en")
  subtitleId         String?     @map("subtitle_id")
  subtitleEn         String?     @map("subtitle_en")
  badgeId            String?     @map("badge_id")
  badgeEn            String?     @map("badge_en")
  ctaPrimaryTextId   String?     @map("cta_primary_text_id")
  ctaPrimaryTextEn   String?     @map("cta_primary_text_en")
  ctaPrimaryUrl      String?     @map("cta_primary_url")
  ctaSecondaryTextId String?     @map("cta_secondary_text_id")
  ctaSecondaryTextEn String?     @map("cta_secondary_text_en")
  ctaSecondaryUrl    String?     @map("cta_secondary_url")
  imageUrl           String      @map("image_url")
  imageAlt           String?     @map("image_alt")
  sortOrder          Int         @default(0) @map("sort_order")
  isActive           Boolean     @default(true) @map("is_active")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@index([sectionId])
  @@index([sortOrder])
  @@map("cms_hero_slides")
}

model CmsComparisonItem {
  id                   String      @id @default(cuid())
  sectionId            String?     @map("section_id")
  section              CmsSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  number               String      @db.VarChar(10)
  conventionalTitleId  String      @map("conventional_title_id")
  conventionalTitleEn  String      @map("conventional_title_en")
  conventionalDescId   String      @map("conventional_desc_id")
  conventionalDescEn   String      @map("conventional_desc_en")
  diagnovaTitleId      String      @map("diagnova_title_id")
  diagnovaTitleEn      String      @map("diagnova_title_en")
  diagnovaDescId       String      @map("diagnova_desc_id")
  diagnovaDescEn       String      @map("diagnova_desc_en")
  impactMetric         String      @map("impact_metric") @db.VarChar(100)
  sortOrder            Int         @default(0) @map("sort_order")
  isActive             Boolean     @default(true) @map("is_active")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@index([sectionId])
  @@index([sortOrder])
  @@map("cms_comparison_items")
}

model CmsTestimonial {
  id          String      @id @default(cuid())
  sectionId   String?     @map("section_id")
  section     CmsSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(120)
  roleId      String      @map("role_id_text") @db.VarChar(120)
  roleEn      String?     @map("role_en_text") @db.VarChar(120)
  institution String      @db.VarChar(150)
  quoteId     String      @map("quote_id")
  quoteEn     String      @map("quote_en")
  avatarUrl   String      @default("/images/testimonial-silhouette-female.jpg") @map("avatar_url")
  rating      Int         @default(5)
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([sectionId])
  @@index([sortOrder])
  @@map("cms_testimonials")
}

model CmsPartner {
  id        String      @id @default(cuid())
  sectionId String?     @map("section_id")
  section   CmsSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String      @db.VarChar(120)
  logoUrl   String      @map("logo_url")
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([sectionId])
  @@index([sortOrder])
  @@map("cms_partners")
}
