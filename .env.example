# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session JWT secret (WAJIB di production, minimal 32 karakter)
AUTH_SECRET="ganti-dengan-random-string-minimal-32-karakter"

# Base URL publik untuk tautan magic link (dibaca saat runtime; WAJIB di production)
APP_BASE_URL="http://localhost:3000"

# Secret job terjadwal /api/cron/expire-demos (minimal 16 karakter; kosong = job nonaktif)
CRON_SECRET="ganti-dengan-random-string"

# Notification / Sales Email
SALES_NOTIFICATION_EMAIL="hello@tibatibagency.com"
SALES_PHONE_NUMBER="0819 9107 0928"

# Email Service Provider (e.g. Resend, SendGrid, or Nodemailer SMTP)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="Diagnova <no-reply@diagnova.id>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASS="secret_password"

# Database Connection (PostgreSQL 15 - Local Port 5433)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/diagnova?schema=public"

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
