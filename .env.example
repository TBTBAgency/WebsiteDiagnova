# Application
# APP_URL (server-side, dibaca saat runtime) = origin publik untuk tautan yang dikirim keluar,
# terutama Magic Link via WhatsApp/email. Contoh production/Vercel:
#   APP_URL="https://website-diagnova.vercel.app"
# - Kosong di development  -> http://localhost:3000
# - Kosong di Vercel       -> domain otomatis Vercel (VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL)
# - Production TIDAK PERNAH memakai localhost: approval akan ditolak (HTTP 503) bila APP_URL
#   menunjuk ke localhost atau tidak memakai https.
# - ALLOW_LOCALHOST_APP_URL="true" hanya untuk QA build production di mesin lokal
#   (selalu diabaikan di Vercel). Jangan diset di server sungguhan.
APP_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification / Sales Email
SALES_NOTIFICATION_EMAIL="hello@tibatibagency.com"
SALES_PHONE_NUMBER="0819 9107 0928"

# Email Service Provider (e.g. Resend, SendGrid, or Nodemailer SMTP)
# RESEND_API_KEY="re_123456789"
# EMAIL_FROM="Diagnova <no-reply@diagnova.id>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASS="secret_password"

# Database Connection (PostgreSQL 15 - Local Port 5433)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/diagnova?schema=public"

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Tujuan setelah klien demo berhasil masuk lewat Magic Link (https). Sementara memakai website
# company profile karena URL aplikasi LIS belum tersedia; ganti ke URL LIS demo bila sudah ada.
DEMO_ACCESS_URL="https://website-diagnova.vercel.app/"
