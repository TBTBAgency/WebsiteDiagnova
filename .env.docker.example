# ==============================================================================
# DIAGNOVA - DOCKER DEVELOPMENT ENVIRONMENT VARIABLES (.env.docker)
# ==============================================================================
# File ini digunakan sebagai acuan variabel environment ketika menjalankan
# aplikasi di dalam Docker Compose. Salin file ini menjadi .env.docker:
# cp .env.docker.example .env.docker
# ==============================================================================

# Application URL
# APP_URL = origin publik untuk Magic Link (lihat penjelasan di .env.example).
# Kosong = http://localhost:3000 (development). Production wajib https, bukan localhost.
APP_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification / Sales Email
SALES_NOTIFICATION_EMAIL="hello@tibatibagency.com"
SALES_PHONE_NUMBER="0819 9107 0928"

# Auth Secret (JWT) — WAJIB string acak unik >= 32 karakter, mis. hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Kosong = memakai secret khusus development (DITOLAK saat NODE_ENV=production).
AUTH_SECRET=""

# Path login admin RAHASIA (server-side, tidak pernah dikirim ke browser). Satu segmen, 8-64 karakter
# huruf/angka/-/_ ; mis. hasil: node -e "console.log('/masuk-'+require('crypto').randomBytes(9).toString('base64url'))"
# Seluruh /admin/* menghasilkan 404 bagi selain ADMIN, dan /admin/login langsung juga 404.
# - Kosong di development -> login di /admin/login
# - Kosong di production  -> login admin TIDAK tersedia (fail-closed). Bagikan path ini hanya ke admin.
ADMIN_LOGIN_PATH=""

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PILIH SALAH SATU)
# ------------------------------------------------------------------------------
# PENDEKATAN 1 (Default Aktif):
# Terhubung langsung ke database PostgreSQL 15 lokal di Windows (Port 5433).
# Dari dalam container, gunakan hostname 'host.docker.internal' bukan 'localhost'.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@host.docker.internal:5433/diagnova?schema=public"

# PENDEKATAN 2 (Opsional - Terisolasi di Docker):
# Jika menjalankan container PostgreSQL terpisah dengan 'docker compose --profile with-db up':
# DATABASE_URL="postgresql://postgres:postgres123@db:5432/diagnova?schema=public"
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres123
# POSTGRES_DB=diagnova
# DOCKER_DB_PORT=5434
