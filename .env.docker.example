# ==============================================================================
# DIAGNOVA - DOCKER DEVELOPMENT ENVIRONMENT VARIABLES (.env.docker)
# ==============================================================================
# File ini digunakan sebagai acuan variabel environment ketika menjalankan
# aplikasi di dalam Docker Compose. Salin file ini menjadi .env.docker:
# cp .env.docker.example .env.docker
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification / Sales Email
SALES_NOTIFICATION_EMAIL="hello@tibatibagency.com"
SALES_PHONE_NUMBER="0819 9107 0928"

# Auth Secret (JWT)
AUTH_SECRET="diagnova-super-secret-key-development-2026-xyz"

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PILIH SALAH SATU)
# ------------------------------------------------------------------------------
# PENDEKATAN 1 (Default Aktif):
# Terhubung langsung ke database PostgreSQL 15 lokal di Windows (Port 5433).
# Dari dalam container, gunakan hostname 'host.docker.internal' bukan 'localhost'.
DATABASE_URL="postgresql://postgres:12345@host.docker.internal:5433/diagnova?schema=public"

# PENDEKATAN 2 (Opsional - Terisolasi di Docker):
# Jika menjalankan container PostgreSQL terpisah dengan 'docker compose --profile with-db up':
# DATABASE_URL="postgresql://postgres:postgres123@db:5432/diagnova?schema=public"
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres123
# POSTGRES_DB=diagnova
# DOCKER_DB_PORT=5434
